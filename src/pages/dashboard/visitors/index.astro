---
import AdminLayout from "@plumia/layouts/AdminLayout.astro";
import * as AuthService from "@plumia/services/auth.service";
import * as VisitorsRepository from "@plumia/repositories/visitors.repository";
import dayjs from "dayjs";

import utc from 'dayjs/plugin/utc';
import timezone from 'dayjs/plugin/timezone';

dayjs.extend(utc);
dayjs.extend(timezone);

let auth = AuthService.isAuth(Astro);

if (!auth) {
  return Astro.redirect("/auth/sign-in");
}

let visitors = await VisitorsRepository.getVisitorsByAdminId(auth?.userId!);

dayjs.tz.setDefault('America/Mexico_City');
---

<AdminLayout title="Visitantes" username={auth?.name!} email={auth?.email!} breadcrumb={{
  title: "Visitantes",
  url: "dashboard/visitors"
}}>
  <section class="flex items-center bg-gray-50 dark:bg-gray-900 mb-6">
    <div class="w-full">
      <!-- Start coding here -->
      <div
        class="relative overflow-hidden bg-white shadow-md dark:bg-gray-800 sm:rounded-lg"
      >
        <div
          class="flex-row items-center justify-between p-4 space-y-3 sm:flex sm:space-y-0 sm:space-x-4"
        >
          <div>
            <h5 class="mr-3 font-semibold dark:text-white">
              Registro de visitantes
            </h5>
            <p class="text-gray-500 dark:text-gray-400">
              Visualiza los visitantes del día a tu parque de estacionamiento
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative overflow-x-auto shadow-md sm:rounded-lg mb-6">
    <table
      class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400"
    >
      <thead
        class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400"
      >
        <tr>
          <th scope="col" class="px-6 py-3"> Visitante </th>
          <th scope="col" class="px-6 py-3"> cajón </th>
          <th scope="col" class="px-6 py-3"> Fecha inicio </th>
          <th scope="col" class="px-6 py-3"> Fecha final </th>
          <th scope="col" class="px-6 py-3"> HORAS </th>
          <th scope="col" class="px-6 py-3"> estado </th>
        </tr>
      </thead>
      <tbody>

        {visitors.map(visitor => (
          <tr
          class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600"
        >
          <th
            scope="row"
            class="flex items-center px-6 py-4 text-gray-900 whitespace-nowrap dark:text-white"
          >
            <img
              class="w-10 h-10 rounded-full"
              src="/user.jpg"
              alt="Jese image"
            />
            <div class="ps-3">
              <div class="text-base font-semibold">{visitor.username}</div>
              <div class="font-normal text-gray-500">
                {visitor.vehicle}
              </div>
            </div>
          </th>
          <td class="px-6 py-4">{visitor.spotid}</td>
          <td class="px-6 py-4">{visitor.initialdate ? dayjs(new Date(visitor.initialdate)).format('DD/MM/YYYY HH:mm:ss') : ''}</td>
          <td class="px-6 py-4">{visitor.finaldate ? dayjs(new Date(visitor.finaldate)).format('DD/MM/YYYY HH:mm:ss') : ''}</td>
          <td class="px-6 py-4">{visitor.diff}</td>
          <td class="px-6 py-4">
            <div class="flex items-center">
              {visitor.finaldate ? (<div class="h-2.5 w-2.5 rounded-full bg-green-500 me-2"></div>) : (<div class="h-2.5 w-2.5 rounded-full bg-yellow-500 me-2"></div>)} {visitor.finaldate ? 'Finalizado' : 'En curso'}
            </div>
          </td>
        </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>