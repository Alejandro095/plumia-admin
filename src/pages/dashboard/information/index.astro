---
import AdminLayout from "@plumia/layouts/AdminLayout.astro";
import * as AuthService from "@plumia/services/auth.service";
import * as UserRepository from "@plumia/repositories/user.repository";
import * as MallRepository from "@plumia/repositories/mall.repository";

let auth = AuthService.isAuth(Astro);

if (!auth) {
  return Astro.redirect("/auth/sign-in");
}

let user = await UserRepository.get(auth.userId!);
let mall = await MallRepository.get(auth.userId!);

if (!user || !mall) {
  return Astro.redirect("/auth/sign-in");
}

---

<AdminLayout username={auth?.name!} email={auth?.email!} breadcrumb={{
  title: "Información",
  url: "/dashboard/information"
}}>
  <div class="grid grid-cols-1 xl:grid-cols-3 xl:gap-4 dark:bg-gray-900 mb-4">
    <!-- Right Content -->
    <div class="col-span-full xl:col-auto">
      <div
        class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800"
      >
        <div
          class="items-center sm:flex xl:block 2xl:flex sm:space-x-4 xl:space-x-0 2xl:space-x-4"
        >
          <img
            class="mb-4 rounded-lg w-28 h-28 sm:mb-0 xl:mb-4 2xl:mb-0"
            src="/user.jpg"
            alt="Jese picture"
          />
          <div>
            <h3 class="mb-1 text-xl font-bold text-gray-900 dark:text-white">
              {user.name}
            </h3>
            <div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              {user.email}
            </div>
          </div>
        </div>
      </div>
      <div
        class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800"
      >
        <div
          class="items-center sm:flex xl:block 2xl:flex sm:space-x-4 xl:space-x-0 2xl:space-x-4"
        >
          <img
            class="mb-4 rounded-lg w-28 h-28 sm:mb-0 xl:mb-4 2xl:mb-0"
            src="/user.jpg"
            alt="Jese picture"
          />
          <div>
            <h3 class="mb-1 text-xl font-bold text-gray-900 dark:text-white">
              Plaza
            </h3>
            <div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              {mall.name}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-span-2">
      <div
        class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800"
      >
        <h3 class="mb-4 text-xl font-semibold dark:text-white">
          Información general
        </h3>
        <form id="general" method="POST" action="/api/information/update/information">
          <div class="grid grid-cols-6 gap-6">
            <div class="col-span-6 sm:col-span-3">
              <label
                for="name"
                class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                >Nombre</label
              >
              <input
                type="text"
                name="name"
                id="name"
                class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                value={user.name}
                required=""
              />
            </div>
            <div class="col-span-6 sm:col-span-3">
              <label
                for="email"
                class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                >Correo</label
              >
              <input
                type="text"
                name="email"
                id="email"
                class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                value={user.email}
                required=""
              />
            </div>
            <div class="col-span-6 sm:col-span-3">
              <label
                for="mallName"
                class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                >Plaza</label
              >
              <input
                type="text"
                name="mallName"
                id="mallName"
                class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                value={mall.name}
                required=""
              />
            </div>
            <div class="col-span-6 sm:col-span-3">
              <label
                for="mallCost"
                class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                >Costo</label
              >
              <input
                type="text"
                name="mallCost"
                id="mallCost"
                class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                value={mall.cost}
                required=""
              />
            </div>
            <div class="col-span-6 sm:col-full flex justify-end">
              <button
                class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
                type="submit">Actualizar datos</button
              >
            </div>
            </div>
          </form>
          <form class="mt-6" method="POST" action="/api/information/update/password">
            <div class="grid grid-cols-6 gap-6">
              <div class="col-span-6">
                <label
                  for="password"
                  class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                  >Actualizar contraseña</label
                >
                <input
                  type="password"
                  name="password"
                  min="6"
                  id="password"
                  class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                  placeholder="Escoge una nueva contraseña segura"
                  required=""
                />
              </div>
              <div class="col-span-6 sm:col-full flex justify-end">
                <button
                  class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
                  type="submit">Actualizar contraseña</button
                >
              </div>
            </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>
