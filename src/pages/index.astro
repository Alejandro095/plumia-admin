---
import Document from "@plumia/layouts/Document.astro";
import LayoutAdmin from "@plumia/layouts/LayoutAdmin.astro";
---

<Document title="Hola">
  <LayoutAdmin>
    <h1>Hola</h1>
    <button id="button">Login</button>
  </LayoutAdmin>
</Document>

<script>
  const { signIn, signOut } = await import("auth-astro/client");
  document.getElementById("button").addEventListener("click", async () => {
    await signIn();
  });
</script>
