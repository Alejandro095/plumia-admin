---
import Document from "./Document.astro";

import Aside from "../components/Aside.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Breadcrumb from "@plumia/components/Breadcrumb.astro";

interface Props {
    username: string;
    email: string;
}


const { email, username } = Astro.props
---

<Document title="Title">
    <div class="flex-1 antialiased bg-gray-50 dark:bg-gray-900">
        <Navbar username={username} email={email}  />

        <Aside />

        <main class="p-4 md:ml-64 pt-20 flex flex-col h-full">
            <Breadcrumb title="Inicio" url="/" />

            <div class="flex-1">
                <slot />
            </div>

            <Footer />
        </main>
    </div>
</Document>
