---
import Document from "./Document.astro";

import Aside from "../components/Aside.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Breadcrumb from "@plumia/components/Breadcrumb.astro";

interface Props {
    username: string;
    email: string;
    breadcrumb: { title: string; url: string };
    title: string;
}


const { email, username, breadcrumb, title } = Astro.props
---

<Document title={`PlumIA - ${title}`}>
    <div class="flex-1 antialiased bg-gray-50 dark:bg-gray-900">
        <Navbar username={username} email={email}  />

        <Aside />

        <main class="p-4 md:ml-64 pt-20 flex flex-col h-full min-h-[100vh]">
            <Breadcrumb title={breadcrumb.title} url={breadcrumb.url} />

            <div class="flex-1">
                <slot />
            </div>

            <Footer />
        </main>
    </div>
</Document>
